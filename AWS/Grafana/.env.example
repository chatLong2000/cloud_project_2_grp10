# Copy to AWS/Grafana/.env and set a real password (.env is git-ignored).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# Replay dataset mounted into the analyser (generated with: python -m analyser.generator --out ...)
REPLAY_DIR=../Analyser/data/replay/ref
# Replay position mapped to "now" at startup: everything before it is preloaded (history for the dashboard and detectors)
REPLAY_START_OFFSET_S=3600
ANALYSER_POLL_INTERVAL_S=10
LOG_LEVEL=INFO
